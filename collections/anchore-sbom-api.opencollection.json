{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anchore Enterprise Images SBOM API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SBOM",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Anchore Enterprise Get Image SBOM",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://anchore.example.com/v2/images/:imageDigest/sbom",
            "params": [
              {
                "name": "imageDigest",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve the Software Bill of Materials for an analyzed image"
        }
      ]
    }
  ],
  "bundled": true
}